# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Translation Engine Configuration
TRANSLATION_PROVIDER=mock          # Options: mock, sarvam
TRANSLATION_API_URL=https://api.sarvam.ai/translate
TRANSLATION_API_KEY=mock_translation_key
TRANSLATION_TIMEOUT_SECONDS=5.0

# ASR Configuration
ASR_PROVIDER=mock                 # Options: mock, sarvam
ASR_API_KEY=mock_asr_key
ASR_MODEL_NAME=saaras:v1

# TTS Configuration
TTS_PROVIDER=mock                 # Options: mock, bhashini, ai4bharat
TTS_API_KEY=mock_tts_key
TTS_USER_ID=mock_bhashini_user_id
TTS_SERVICE_ID=bhashini/ai4bharat/indic-tts-sat
TTS_VOICE_ID=female
TTS_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/tts
TTS_TIMEOUT_SECONDS=10.0

# AI4Bharat Offline TTS Configuration
TTS_MODEL_NAME=ai4bharat/indic-parler-tts
TTS_DEVICE=auto                    # Options: auto, cuda, cpu

